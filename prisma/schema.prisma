/**
 * Organization-configured Skill Types (e.g. Languages, Soft Skills) each
 * containing named Skills; HrEmployeeSkill is the per-employee assignment
 * with a 1-5 level. No stored progress percentage - the UI derives it as
 * level/5*100 so it can never drift out of sync with the level itself.
 */
model HrSkillType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills       HrSkill[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

