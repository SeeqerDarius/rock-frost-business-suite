  commissionPercentage            Decimal  @default(0) @db.Decimal(5, 2)
  payrollDay                      Int      @default(1)
  receiptPrefix                   String   @default("RCPT")
  customerIdPrefix                String   @default("CUST")
  staffCodeLength                 Int      @default(3)
