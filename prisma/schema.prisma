model ModuleRequestEvent {
  id              String               @id @default(cuid())
  moduleRequestId String
  authorId        String?
  fromStatus      ModuleRequestStatus?
  toStatus        ModuleRequestStatus?
  note            String?              @db.Text
  isInternal      Boolean              @default(false)
  createdAt       DateTime             @default(now())

  moduleRequest ModuleRequest @relation(fields: [moduleRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([moduleRequestId, createdAt])
  @@index([authorId])
}

enum AuditEventStatus {
  SUCCESS
  FAILURE
}

enum OfflineDeviceStatus {
  ACTIVE
  REVOKED
}

enum OfflineMutationStatus {
  PROCESSING
  APPLIED
  CONFLICT
  REJECTED
}

enum OfflineConflictStatus {
  OPEN
  RESOLVED
}

/**
 * Append-only through application logic (no update/delete path is ever
 * exposed — see docs/HARDENING_PLAN.md's Pass 4 audit-logging section).
 * `module` is the source module key (e.g. "accounting", "auth",
 * "administration" — matching the registry's module keys where
 * applicable, plus a few cross-cutting ones that aren't real modules).
 * `changes` is the existing generic structured-metadata field (kept its
 * original name for backward compatibility with the handful of call
 * sites that already write to it) — never put passwords, hashes, session
 * tokens, raw invitation tokens, or full request bodies in it.
 * `organizationId` is nullable — most events are tenant-scoped, but a
 * failed login for an email that matches no user (or a user with zero
 * organization memberships) genuinely has no organization to attach to.
 */
model AuditLog {
  id             String           @id @default(cuid())
  organizationId String?
  branchId       String?
  userId         String?
  membershipId   String?
  module         String?
  action         String
  entityName     String
  entityId       String?
  status         AuditEventStatus @default(SUCCESS)
  correlationId  String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership   OrganizationMember? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId])
  @@index([userId])
  @@index([membershipId])
  @@index([entityName, entityId])
  @@index([module])
  @@index([correlationId])
}

/**
 * A tenant-scoped desktop installation. Only a SHA-256 hash of the bearer
 * token is persisted. Revocation is checked on every sync request.
 */
model OfflineDevice {
  id                 String              @id @default(cuid())
  organizationId     String
  userId             String
  membershipId       String
  name               String
  platform           String
  installationId     String
  tokenHash          String              @unique
  status             OfflineDeviceStatus @default(ACTIVE)
  moduleKeys         String[]
  tokenExpiresAt     DateTime
  offlineAccessUntil DateTime
  lastSeenAt         DateTime?
  lastSyncAt         DateTime?
  revokedAt          DateTime?
  revokedById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation("OfflineDeviceUser", fields: [userId], references: [id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  revokedBy    User?              @relation("OfflineDeviceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  mutations    OfflineMutation[]
  conflicts    OfflineConflict[]

  @@unique([organizationId, installationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([membershipId])
}

/**
 * Single-use, short-lived bridge between an authenticated web session and a desktop installation.
 */
model OfflineActivationCode {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  membershipId   String
  codeHash       String    @unique
  moduleKeys     String[]
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, expiresAt])
  @@index([membershipId])
}

/**
 * Durable idempotency record for one desktop mutation. The unique tenant and
 * mutation ID pair prevents retries from applying a financial or stock event
 * twice. Payloads are bounded and validated before persistence.
 */
model OfflineMutation {
  id             String                @id @default(cuid())
  organizationId String
  deviceId       String
  userId         String
  mutationId     String
  moduleKey      String
  entityType     String
  entityId       String
  operation      String
  baseVersion    Int
  payload        Json
  status         OfflineMutationStatus @default(PROCESSING)
  result         Json?
  errorCode      String?
  changedAt      DateTime
  appliedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       OfflineDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conflict     OfflineConflict?

  @@unique([organizationId, mutationId])
  @@index([deviceId, createdAt])
  @@index([organizationId, moduleKey, createdAt])
  @@index([organizationId, status])
}

/**
 * Conflicts are resolved explicitly and never overwritten in place. The
 * original local payload remains on OfflineMutation for audit history.
 */
model OfflineConflict {
  id                 String                @id @default(cuid())
  organizationId     String
  deviceId           String
  mutationId         String                @unique
  conflictType       String
  cloudVersion       Int?
  cloudSnapshot      Json?
  allowedResolutions String[]
  status             OfflineConflictStatus @default(OPEN)
  resolution         String?
  resolutionPayload  Json?
  resolvedById       String?
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       OfflineDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  mutation     OfflineMutation @relation(fields: [mutationId], references: [id], onDelete: Cascade)
  resolvedBy   User?           @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([deviceId, status])
}

/**
 * Public marketing-site contact form submissions — not tenant-scoped (there
 * is no organization context before a lead becomes a customer). Persisting
 * these (rather than only emailing and forgetting, as the previous
 * implementation did whenever RESEND_TO_EMAIL was unset) also enables a
 * simple per-email rate-limit check on new submissions.
 */
model ContactSubmission {
  id               String                  @id @default(cuid())
  name             String
  company          String
  email            String
  phone            String?
  preferredContact ContactPreference       @default(EMAIL)
  intent           EnquiryIntent           @default(GENERAL)
  reason           String
  moduleId         String?
  expectedUsers    Int?
  country          String?
  industry         String?
  message          String?                 @db.Text
  status           ContactSubmissionStatus @default(NEW)
  organizationId   String?
  assignedToId     String?
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("ContactSubmissionsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  module        Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  moduleRequest ModuleRequest?
  subscription  Subscription?

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([moduleId])
}

model Subscription {
  id                         String                  @id @default(cuid())
  organizationId             String
  moduleId                   String
