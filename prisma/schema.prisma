  vendorId       String
  orderId        String
  invoiceNumber  String
  invoiceDate    DateTime
  dueDate        DateTime?
  status         ProcurementSupplierInvoiceStatus @default(DRAFT)
  totalAmount    Decimal                          @db.Decimal(12, 2)
  taxableAmount  Decimal                          @default(0) @db.Decimal(12, 2)
  vatAmount      Decimal                          @default(0) @db.Decimal(12, 2)
  nhilAmount     Decimal                          @default(0) @db.Decimal(12, 2)
  getfundAmount  Decimal                          @default(0) @db.Decimal(12, 2)
  taxCodeId      String?
  amountPaid     Decimal                          @default(0) @db.Decimal(12, 2)
  exceptionNote  String?                          @db.Text
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime                         @default(now())
