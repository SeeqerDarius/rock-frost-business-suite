  source             String?
  channelReference   String?
  specialRequests    String?                @db.Text
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room         HotelRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guest        HotelGuest    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  folio        HotelFolio?

  @@unique([organizationId, confirmationCode])
  @@index([organizationId, status, arrivalDate])
  @@index([roomId, arrivalDate, departureDate])
  @@index([guestId])
}

model HotelFolio {
  id             String   @id @default(cuid())
  organizationId String
  reservationId  String   @unique
  folioNumber    String
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  HotelReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  entries      HotelFolioEntry[]
  payments     HotelPayment[]
  orders       HotelOrder[]

  @@unique([organizationId, folioNumber])
  @@index([organizationId, closedAt])
}

model HotelFolioEntry {
  id             String              @id @default(cuid())
  organizationId String
  folioId        String
  type           HotelFolioEntryType
  description    String
  amount         Decimal             @db.Decimal(12, 2)
  reference      String?
  reversedEntryId String?
  postedAt       DateTime            @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folio        HotelFolio      @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@index([organizationId, postedAt])
  @@index([folioId])
  @@index([reversedEntryId])
}

model HotelPayment {
  id             String             @id @default(cuid())
  organizationId String
  folioId        String
  receiptNumber  String
  amount         Decimal            @db.Decimal(12, 2)
  method         HotelPaymentMethod
  reference      String?
  refundedAt     DateTime?
  receivedAt     DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folio        HotelFolio  @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, receivedAt])
  @@index([folioId])
}

model HotelHousekeepingTask {
  id             String                  @id @default(cuid())
  organizationId String
  roomId         String
  status         HotelHousekeepingStatus @default(PENDING)
  assignedTo     String?
  priority       String                  @default("NORMAL")
  notes          String?                 @db.Text
  dueAt          DateTime?
  completedAt    DateTime?
  inspectedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room         HotelRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([roomId])
}

model HotelRestaurantOutlet {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  menuItems    HotelMenuItem[]
  orders       HotelOrder[]

  @@unique([propertyId, name])
  @@index([organizationId, active])
}

model HotelMenuItem {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  category       String?
  price          Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       HotelRestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderLines   HotelOrderLine[]

  @@index([organizationId, active])
  @@index([outletId])
}

model HotelOrder {
  id             String           @id @default(cuid())
  organizationId String
  outletId       String
  folioId        String?
  orderNumber    String
  tableOrRoom    String?
  status         HotelOrderStatus @default(OPEN)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  openedAt       DateTime         @default(now())
  completedAt    DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       HotelRestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  folio        HotelFolio?           @relation(fields: [folioId], references: [id], onDelete: SetNull)
  lines        HotelOrderLine[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([outletId])
}

model HotelOrderLine {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  menuItemId     String?
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        HotelOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     HotelMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([orderId])
}

model HotelChannel {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  provider       String
  externalPropertyId String?
  active         Boolean  @default(false)
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, provider])
  @@index([organizationId, active])
}

model HotelSettings {
  id                            String   @id @default(cuid())
  organizationId                String
  propertyId                    String   @unique
  checkInTime                   String   @default("14:00")
  checkOutTime                  String   @default("11:00")
  taxRate                       Decimal  @default(0) @db.Decimal(5, 2)
  serviceChargeRate             Decimal  @default(0) @db.Decimal(5, 2)
  allowOutstandingCheckout      Boolean  @default(false)
  reservationPrefix             String   @default("RSV")
  folioPrefix                   String   @default("FOL")
  receiptPrefix                 String   @default("HRC")
  orderPrefix                   String   @default("ORD")
  autoCreateCheckoutTask        Boolean  @default(true)
  housekeepingDueHours          Int      @default(4)
  requireHousekeepingInspection Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum SchoolStudentStatus {
  APPLICANT
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

enum SchoolEnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum SchoolAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolInvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  VOID
}

enum SchoolExamStatus {
  DRAFT
  OPEN
  MODERATION
  PUBLISHED
  CLOSED
}

enum SchoolLibraryLoanStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

model SchoolCampus {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
  name           String
  address        String?
  phone          String?
  email          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classes      SchoolClass[]
  students     SchoolStudent[]
  enrollments  SchoolEnrollment[]
  timetable    SchoolTimetableEntry[]
  routes       SchoolTransportRoute[]
  settings     SchoolSettings?

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([branchId])
}

model SchoolAcademicYear {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  current        Boolean  @default(false)
  closedAt       DateTime?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms        SchoolTerm[]
  enrollments  SchoolEnrollment[]
  feeInvoices  SchoolFeeInvoice[]
  exams        SchoolExam[]

  @@unique([organizationId, name])
  @@index([organizationId, current])
}

model SchoolTerm {
  id             String   @id @default(cuid())
  organizationId String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  current        Boolean  @default(false)
  closedAt       DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear SchoolAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendance   SchoolAttendance[]
  feeInvoices  SchoolFeeInvoice[]
  exams        SchoolExam[]
  timetable    SchoolTimetableEntry[]

  @@unique([academicYearId, name])
  @@index([organizationId, current])
}

model SchoolGuardian {
  id             String   @id @default(cuid())
  organizationId String
  guardianNumber String
  firstName      String
  lastName       String
  email          String?
  phone          String
  address        String?
  occupation     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     SchoolStudentGuardian[]

  @@unique([organizationId, guardianNumber])
  @@index([organizationId, phone])
}

model SchoolStudent {
  id              String              @id @default(cuid())
  organizationId  String
  campusId        String
  admissionNumber String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  status          SchoolStudentStatus @default(APPLICANT)
  admissionDate   DateTime?
  medicalNotes    String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  guardians    SchoolStudentGuardian[]
  enrollments  SchoolEnrollment[]
  attendance   SchoolAttendance[]
  feeInvoices  SchoolFeeInvoice[]
  feePayments  SchoolFeePayment[]
  examResults  SchoolExamResult[]
  transport    SchoolTransportAssignment[]
  libraryLoans SchoolLibraryLoan[]

  @@unique([organizationId, admissionNumber])
  @@index([organizationId, status])
  @@index([campusId])
}

model SchoolStudentGuardian {
  id             String  @id @default(cuid())
  organizationId String
  studentId      String
  guardianId     String
  relationship   String
  primary        Boolean @default(false)
  authorizedPickup Boolean @default(false)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      SchoolStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     SchoolGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([organizationId])
  @@index([guardianId])
}

model SchoolClass {
  id             String   @id @default(cuid())
  organizationId String
  campusId       String
  code           String
  name           String
  gradeLevel     String?
  capacity       Int?
  active         Boolean  @default(true)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  enrollments  SchoolEnrollment[]
  attendance   SchoolAttendance[]
  results      SchoolExamResult[]
  timetable    SchoolTimetableEntry[]

  @@unique([campusId, code])
  @@index([organizationId, active])
}

model SchoolSubject {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String? @db.Text
  active         Boolean @default(true)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exams        SchoolExam[]
  results      SchoolExamResult[]
  timetable    SchoolTimetableEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model SchoolEnrollment {
  id             String                 @id @default(cuid())
  organizationId String
  campusId       String
  academicYearId String
  studentId      String
  classId        String
  status         SchoolEnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime               @default(now())
  endedAt        DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicYear SchoolAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  student      SchoolStudent     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class        SchoolClass       @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([organizationId, status])
  @@index([classId])
}

model SchoolAttendance {
  id             String                 @id @default(cuid())
  organizationId String
  termId         String
  classId        String
  studentId      String
  date           DateTime
  status         SchoolAttendanceStatus
  reason         String?
  publishedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  term         SchoolTerm    @relation(fields: [termId], references: [id], onDelete: Restrict)
  class        SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  student      SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([studentId, date])
  @@index([organizationId, date])
  @@index([classId, date])
}

model SchoolFeeInvoice {
  id             String              @id @default(cuid())
  organizationId String
  academicYearId String
  termId         String?
  studentId      String
  invoiceNumber  String
  description    String
  amount         Decimal             @db.Decimal(12, 2)
  discount       Decimal             @default(0) @db.Decimal(12, 2)
  status         SchoolInvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear SchoolAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         SchoolTerm?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  student      SchoolStudent      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payments     SchoolFeePayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([studentId])
}

model SchoolFeePayment {
  id             String             @id @default(cuid())
  organizationId String
  invoiceId      String
  studentId      String
  receiptNumber  String
  amount         Decimal            @db.Decimal(12, 2)
  method         HotelPaymentMethod
  reference      String?
  receivedAt     DateTime           @default(now())
  refundedAt     DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      SchoolFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student      SchoolStudent    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, receivedAt])
  @@index([invoiceId])
}

model SchoolExam {
  id             String           @id @default(cuid())
  organizationId String
  academicYearId String
  termId         String
  subjectId      String
  name           String
  totalMarks     Decimal          @default(100) @db.Decimal(6, 2)
  weight         Decimal          @default(100) @db.Decimal(5, 2)
  status         SchoolExamStatus @default(DRAFT)
  examDate       DateTime?
  publishedAt    DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear SchoolAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         SchoolTerm         @relation(fields: [termId], references: [id], onDelete: Restrict)
  subject      SchoolSubject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  results      SchoolExamResult[]

  @@index([organizationId, status])
  @@index([termId, subjectId])
}

model SchoolExamResult {
  id             String   @id @default(cuid())
  organizationId String
  examId         String
  studentId      String
  classId        String
  subjectId      String
  marks          Decimal  @db.Decimal(6, 2)
  grade          String?
  remark         String?
  moderatedAt    DateTime?
  publishedAt    DateTime?
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exam         SchoolExam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class        SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject      SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([examId, studentId])
  @@index([organizationId])
  @@index([classId, subjectId])
}

model SchoolTimetableEntry {
  id             String   @id @default(cuid())
  organizationId String
  campusId       String
  termId         String
  classId        String
  subjectId      String
  teacherName    String
  room           String?
  dayOfWeek      Int
  startsAt       String
  endsAt         String
  publishedAt    DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  term         SchoolTerm   @relation(fields: [termId], references: [id], onDelete: Restrict)
  class        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([organizationId, dayOfWeek])
  @@index([classId, dayOfWeek])
}

model SchoolTransportRoute {
  id             String  @id @default(cuid())
  organizationId String
  campusId       String
  code           String
  name           String
  vehicle        String?
  driverName     String?
  stops          Json?
  fee            Decimal @default(0) @db.Decimal(12, 2)
  active         Boolean @default(true)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  assignments  SchoolTransportAssignment[]

  @@unique([campusId, code])
  @@index([organizationId, active])
}

model SchoolTransportAssignment {
  id             String  @id @default(cuid())
  organizationId String
  routeId        String
  studentId      String
  stopName       String?
  active         Boolean @default(true)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route        SchoolTransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student      SchoolStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([routeId, studentId])
  @@index([organizationId, active])
}

model SchoolLibraryBook {
  id             String  @id @default(cuid())
  organizationId String
  accessionCode  String
  isbn           String?
  title          String
  author         String?
  category       String?
  totalCopies    Int     @default(1)
  availableCopies Int   @default(1)
  active         Boolean @default(true)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loans        SchoolLibraryLoan[]

  @@unique([organizationId, accessionCode])
  @@index([organizationId, active])
}

model SchoolLibraryLoan {
  id             String                  @id @default(cuid())
  organizationId String
  bookId         String
  studentId      String
  status         SchoolLibraryLoanStatus @default(BORROWED)
  borrowedAt     DateTime                @default(now())
  dueAt          DateTime
  returnedAt     DateTime?
  fineAmount     Decimal                 @default(0) @db.Decimal(12, 2)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  book         SchoolLibraryBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student      SchoolStudent     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([studentId])
}

model SchoolPayrollAdjustment {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  period         String
  type           String
  description    String
  amount         Decimal  @db.Decimal(12, 2)
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period])
  @@index([employeeId])
}

model SchoolSettings {
  id             String   @id @default(cuid())
  organizationId String
  campusId       String   @unique
  gradingScale   Json?
  attendanceCloseDays Int @default(7)
  receiptPrefix  String   @default("SCH")
  allowRanking   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
