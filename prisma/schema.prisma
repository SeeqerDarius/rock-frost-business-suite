  fleetOwners                     FleetOwner[]
  fleetDrivers                    FleetDriver[]
  fleetVehicles                   FleetVehicle[]
  fleetVehicleDocuments           FleetVehicleDocument[]
  maintenanceRequests             FleetMaintenanceRequest[]
  fleetMaintenanceEvents          FleetMaintenanceEvent[]
  fleetPayments                   FleetPayment[]
  workAndPayContracts             FleetWorkAndPayContract[]
  hirePurchaseStaff               HirePurchaseStaff[]
  hirePurchaseStaffSalaryPayments HirePurchaseStaffSalaryPayment[]
  hirePurchaseStaffSalaryHistory  HirePurchaseStaffSalaryHistory[]
  hirePurchaseProductCategories   HirePurchaseProductCategory[]
  hirePurchaseProducts            HirePurchaseProduct[]
  hirePurchaseStaffInventory      HirePurchaseStaffInventory[]
  hirePurchaseCustomers           HirePurchaseCustomer[]
  hirePurchaseAccounts            HirePurchaseAccount[]
  hirePurchasePayments            HirePurchasePayment[]
  hirePurchaseCredits             HirePurchaseCredit[]
  hirePurchaseSettings            HirePurchaseSettings?
  crmLeadSources                  CrmLeadSource[]
  crmContacts                     CrmContact[]
  crmLeads                        CrmLead[]
  crmDeals                        CrmDeal[]
  crmActivities                   CrmActivity[]
  inventoryCategories             InventoryCategory[]
  inventoryWarehouses             InventoryWarehouse[]
  inventoryItems                  InventoryItem[]
  inventoryMovements              InventoryMovement[]
  accountingAccounts              AccountingAccount[]
  accountingExpenseCategories     AccountingExpenseCategory[]
  accountingInvoices              AccountingInvoice[]
  accountingExpenses              AccountingExpense[]
  accountingJournalEntries        AccountingJournalEntry[]
  hrEmployees                     HrEmployee[]
  hrLeaveTypes                    HrLeaveType[]
  hrLeaveRequests                 HrLeaveRequest[]
  hrPerformanceReviews            HrPerformanceReview[]
  procurementVendors              ProcurementVendor[]
  procurementRequests             ProcurementRequest[]
  procurementOrders               ProcurementOrder[]
  procurementSettings             ProcurementSettings?
  payrollCompensations            PayrollCompensation[]
  payrollRuns                     PayrollRun[]
  payrollPayslips                 PayrollPayslip[]
  payrollSettings                 PayrollSettings?
  posRegisters                    PosRegister[]
  posSessions                     PosSession[]
  posSales                        PosSale[]
  posSettings                     PosSettings?
  projects                        Project[]
  projectTasks                    ProjectTask[]
  hotelProperties                 HotelProperty[]
  hotelRoomTypes                  HotelRoomType[]
  hotelRooms                      HotelRoom[]
  hotelGuests                     HotelGuest[]
  hotelReservations               HotelReservation[]
  hotelFolios                     HotelFolio[]
  hotelFolioEntries               HotelFolioEntry[]
  hotelPayments                   HotelPayment[]
  hotelHousekeepingTasks          HotelHousekeepingTask[]
  hotelRestaurantOutlets          HotelRestaurantOutlet[]
  hotelMenuItems                  HotelMenuItem[]
  hotelOrders                     HotelOrder[]
  hotelOrderLines                 HotelOrderLine[]
  hotelChannels                   HotelChannel[]
  hotelSettings                   HotelSettings[]
  schoolCampuses                  SchoolCampus[]
  schoolAcademicYears             SchoolAcademicYear[]
  schoolTerms                     SchoolTerm[]
  schoolGuardians                 SchoolGuardian[]
  schoolStudents                  SchoolStudent[]
  schoolStudentGuardians          SchoolStudentGuardian[]
  schoolClasses                   SchoolClass[]
  schoolSubjects                  SchoolSubject[]
  schoolEnrollments               SchoolEnrollment[]
  schoolAttendance                SchoolAttendance[]
  schoolFeeInvoices               SchoolFeeInvoice[]
  schoolFeePayments               SchoolFeePayment[]
  schoolExams                     SchoolExam[]
  schoolExamResults               SchoolExamResult[]
  schoolTimetableEntries          SchoolTimetableEntry[]
  schoolTransportRoutes           SchoolTransportRoute[]
  schoolTransportAssignments      SchoolTransportAssignment[]
  schoolLibraryBooks              SchoolLibraryBook[]
  schoolLibraryLoans              SchoolLibraryLoan[]
  schoolPayrollAdjustments        SchoolPayrollAdjustment[]
  schoolSettings                  SchoolSettings[]
  moduleRequests                  ModuleRequest[]
  contactSubmissions              ContactSubmission[]
