model User {
  id                   String     @id @default(cuid())
  name                 String?
  firstName            String?
  lastName             String?
  email                String     @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  phone                String?
  status               UserStatus @default(INVITED)
  lastLoginAt          DateTime?
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  sessionVersion       Int        @default(0)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean         @default(false)
  twoFactorConfirmedAt DateTime?
  /// Which method is currently active. Only ever one at a time - enabling
  /// SMS requires disabling TOTP first (and vice versa) via the existing
  /// disableTwoFactor flow, since twoFactorEnabled is a single account-wide
  /// flag. Null when 2FA has never been set up.
  twoFactorMethod      TwoFactorMethod?
  /// The phone number SMS 2FA codes are sent to, captured and verified at
  /// enrollment time. Deliberately separate from the general contact `phone`
  /// field above: if they were the same field, editing your profile phone
  /// (e.g. during an account takeover) would silently redirect where login
  /// codes get sent, defeating the point of 2FA.
  twoFactorPhone       String?
  phoneVerifiedAt      DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime   @updatedAt

  accounts                        Account[]
  sessions                        Session[]
  organizationMemberships         OrganizationMember[]
  invitationsCreated              Invitation[]                     @relation("InvitationsCreated")
  auditLogs                       AuditLog[]
  notifications                   Notification[]
  uploadedFiles                   FileAsset[]
  fleetDriverProfiles             FleetDriver[]
  schoolClassTeacherAssignments   SchoolClassTeacher[]
  hostelWardenAssignments         HostelWarden[]
  fleetOwnerProfiles              FleetOwner[]
  maintenanceRequests             FleetMaintenanceRequest[]
  fleetMaintenanceEvents          FleetMaintenanceEvent[]
  hirePurchaseStaffProfiles       HirePurchaseStaff[]
  crmContactsOwned                CrmContact[]
  crmLeadsOwned                   CrmLead[]
  crmDealsOwned                   CrmDeal[]
  crmActivitiesCreated            CrmActivity[]
  inventoryMovementsCreated       InventoryMovement[]
  accountingInvoicesCreated       AccountingInvoice[]
  accountingExpensesCreated       AccountingExpense[]
  accountingJournalEntriesCreated AccountingJournalEntry[]
  accountingPettyCashFundsCreated AccountingPettyCashFund[]
  accountingPettyCashTxnsCreated  AccountingPettyCashTransaction[]
  hrEmployeeProfiles              HrEmployee[]
