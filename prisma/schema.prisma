enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  SUSPENDED
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PosReturnStatus {
  COMPLETED
  VOIDED
}

enum PosPaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

model PosRegister {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  warehouseId    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse    InventoryWarehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sessions     PosSession[]
  sales        PosSale[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
  @@index([warehouseId])
}

model PosSession {
  id             String           @id @default(cuid())
  organizationId String
  registerId     String
  openedById     String?
  closedById     String?
  openingFloat   Decimal          @default(0) @db.Decimal(12, 2)
  closingCash    Decimal?         @db.Decimal(12, 2)
  expectedCash   Decimal?         @db.Decimal(12, 2)
  cashVariance   Decimal?         @db.Decimal(12, 2)
  varianceReason String?
  status         PosSessionStatus @default(OPEN)
  openedAt       DateTime         @default(now())
  closedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  register     PosRegister  @relation(fields: [registerId], references: [id], onDelete: Cascade)
  openedBy     User?        @relation("PosSessionsOpened", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy     User?        @relation("PosSessionsClosed", fields: [closedById], references: [id], onDelete: SetNull)
  sales        PosSale[]

  @@index([organizationId, status])
  @@index([registerId])
}

model PosSale {
  id              String           @id @default(cuid())
  organizationId  String
  registerId      String
  sessionId       String
  saleNumber      String
  customerName    String?
  subtotal        Decimal          @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  paymentMethod   PosPaymentMethod @default(CASH)
  status          PosSaleStatus    @default(COMPLETED)
  soldById        String?
  /**
   * Client-generated key for the offline-sync queue (src/app/app/pos/sell/offline-queue.ts):
   * lets a replayed sync call return the already-created sale instead of creating a
   * duplicate. Null for every sale submitted while online.
   */
  clientRequestId String?
  /**
   * When the sale actually happened, captured client-side at the moment of an offline
   * sale (which may only reach the server, and get its createdAt, minutes later once
   * synced). Null for online sales, where createdAt already reflects this.
   */
  occurredAt      DateTime?
  createdAt       DateTime         @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  register     PosRegister   @relation(fields: [registerId], references: [id], onDelete: Cascade)
  session      PosSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  soldBy       User?         @relation(fields: [soldById], references: [id], onDelete: SetNull)
  lines        PosSaleLine[]
  payments     PosPayment[]
  returns      PosReturn[]

  @@unique([organizationId, saleNumber])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId, status])
  @@index([registerId])
  @@index([sessionId])
}

model PosSaleLine {
  id               String  @id @default(cuid())
  saleId           String
  itemId           String?
  description      String
  skuSnapshot      String?
  barcodeSnapshot  String?
  taxRateSnapshot  Decimal @default(0) @db.Decimal(7, 4)
  discountSnapshot Decimal @default(0) @db.Decimal(12, 2)
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(12, 2)

  sale        PosSale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item        InventoryItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  returnLines PosReturnLine[]

  @@index([saleId])
  @@index([itemId])
}

model PosPayment {
  id             String           @id @default(cuid())
  organizationId String
  saleId         String
  method         PosPaymentMethod
  amount         Decimal          @db.Decimal(12, 2)
  reference      String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         PosSale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId, method])
  @@index([saleId])
}

model PosReturn {
  id             String           @id @default(cuid())
  organizationId String
  saleId         String
  returnNumber   String
  reason         String
  status         PosReturnStatus  @default(COMPLETED)
  refundMethod   PosPaymentMethod
  refundAmount   Decimal          @db.Decimal(12, 2)
  processedById  String?
  createdAt      DateTime         @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         PosSale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lines        PosReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, createdAt])
  @@index([saleId])
}

model PosReturnLine {
  id         String  @id @default(cuid())
  returnId   String
  saleLineId String
  quantity   Int
  unitAmount Decimal @db.Decimal(12, 2)
  lineAmount Decimal @db.Decimal(12, 2)

  return   PosReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLine PosSaleLine @relation(fields: [saleLineId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleLineId])
}

model PosSettings {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  receiptFooterText String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMilestoneStatus {
  PENDING
  COMPLETED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
