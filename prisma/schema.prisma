// --- Hostel Management ---
// A separately subscribable module for schools that also run a boarding
// hostel. Occupants are existing SchoolStudent records (a hostel houses
// students who are already enrolled, not a second identity for them) and
// terms/academic years are School's own - Hostel deliberately owns no
// academic-calendar concept of its own. See docs/HOSTEL_MODULE.md.

enum HostelBedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum HostelAllocationStatus {
  ACTIVE
  ENDED
}

enum HostelInvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  VOID
}

model HostelBuilding {
