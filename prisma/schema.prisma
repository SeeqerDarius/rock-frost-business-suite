model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String?
  branchId       String?
  status         MemberStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invitation   Invitation?
  auditLogs    AuditLog[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([branchId])
  @@index([roleId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/**
 * Bound to one specific OrganizationMember (via a unique membershipId), not
 * just an email — this is what lets accepting one invitation activate only
 * the membership it was issued for, never every INVITED membership a user
 * happens to have. tokenHash is a SHA-256 digest; the raw token is only ever
 * held in memory long enough to build the email link and is never persisted.
 * EXPIRED is deliberately not a stored status — it's derived from
 * `expiresAt < now` at accept time, the same "compute don't store" pattern
 * Installment uses for OVERDUE.
 */
model Invitation {
  id                 String           @id @default(cuid())
  organizationId     String
  membershipId       String           @unique
  email              String
  tokenHash          String           @unique
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime
  createdById        String?
  acceptedAt         DateTime?
  resentCount        Int              @default(0)
  lastSentAt         DateTime?
  lastDeliveryFailed Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("InvitationsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  timezone       String?
  contactEmail   String?
  status         BranchStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members               OrganizationMember[]
  auditLogs             AuditLog[]
  fileAssets            FileAsset[]
  fleetOwners           FleetOwner[]
  fleetDrivers          FleetDriver[]
  fleetVehicles         FleetVehicle[]
  fleetVehicleDocuments FleetVehicleDocument[]
  maintenanceRequests   FleetMaintenanceRequest[]
  fleetPayments         FleetPayment[]
  workAndPayContracts   FleetWorkAndPayContract[]
  hirePurchaseStaff     HirePurchaseStaff[]
  hirePurchaseCustomers HirePurchaseCustomer[]
  hirePurchaseAccounts  HirePurchaseAccount[]
  crmContacts           CrmContact[]
  crmLeads              CrmLead[]
  crmDeals              CrmDeal[]
  crmActivities         CrmActivity[]
  inventoryWarehouses   InventoryWarehouse[]
  accountingInvoices    AccountingInvoice[]
  accountingExpenses    AccountingExpense[]
  hrEmployees           HrEmployee[]
  posRegisters          PosRegister[]
  projects              Project[]
  hotelProperties       HotelProperty[]
  schoolCampuses        SchoolCampus[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         OrganizationMember[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  moduleCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Module {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  status      ModuleStatus @default(ACTIVE)
  isCore      Boolean      @default(false)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationModules OrganizationModule[]
  moduleRequests      ModuleRequest[]
  contactSubmissions  ContactSubmission[]
  subscriptions       Subscription[]
}

model OrganizationModule {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  enabled        Boolean   @default(false)
  configuration  Json?
  enabledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([moduleId])
}

model ModuleRequest {
  id                    String                @id @default(cuid())
  organizationId        String
  moduleId              String?
  requestedById         String
  assignedToId          String?
  contactSubmissionId   String?               @unique
  type                  ModuleRequestType
  status                ModuleRequestStatus   @default(SUBMITTED)
  priority              ModuleRequestPriority @default(NORMAL)
  title                 String
  businessJustification String                @db.Text
  customizationDetails  String?               @db.Text
  expectedUsers         Int?
  externalReference     String?
  decisionReason        String?               @db.Text
  approvedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module            Module?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  requestedBy       User                 @relation("ModuleRequestsCreated", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo        User?                @relation("ModuleRequestsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  contactSubmission ContactSubmission?   @relation(fields: [contactSubmissionId], references: [id], onDelete: SetNull)
  events            ModuleRequestEvent[]
  subscription      Subscription?

  @@index([organizationId, status])
  @@index([moduleId])
  @@index([requestedById])
  @@index([assignedToId, status])
  @@index([createdAt])
}

model ModuleRequestEvent {
  id              String               @id @default(cuid())
  moduleRequestId String
  authorId        String?
  fromStatus      ModuleRequestStatus?
  toStatus        ModuleRequestStatus?
  note            String?              @db.Text
  isInternal      Boolean              @default(false)
  createdAt       DateTime             @default(now())

  moduleRequest ModuleRequest @relation(fields: [moduleRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([moduleRequestId, createdAt])
  @@index([authorId])
}

enum AuditEventStatus {
  SUCCESS
  FAILURE
}

/**
 * Append-only through application logic (no update/delete path is ever
 * exposed — see docs/HARDENING_PLAN.md's Pass 4 audit-logging section).
 * `module` is the source module key (e.g. "accounting", "auth",
 * "administration" — matching the registry's module keys where
 * applicable, plus a few cross-cutting ones that aren't real modules).
 * `changes` is the existing generic structured-metadata field (kept its
 * original name for backward compatibility with the handful of call
 * sites that already write to it) — never put passwords, hashes, session
 * tokens, raw invitation tokens, or full request bodies in it.
 * `organizationId` is nullable — most events are tenant-scoped, but a
 * failed login for an email that matches no user (or a user with zero
 * organization memberships) genuinely has no organization to attach to.
 */
model AuditLog {
  id             String           @id @default(cuid())
  organizationId String?
  branchId       String?
  userId         String?
  membershipId   String?
  module         String?
  action         String
  entityName     String
  entityId       String?
  status         AuditEventStatus @default(SUCCESS)
  correlationId  String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  membership   OrganizationMember? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId])
  @@index([userId])
  @@index([membershipId])
  @@index([entityName, entityId])
  @@index([module])
  @@index([correlationId])
}

/**
 * Public marketing-site contact form submissions — not tenant-scoped (there
 * is no organization context before a lead becomes a customer). Persisting
 * these (rather than only emailing and forgetting, as the previous
 * implementation did whenever RESEND_TO_EMAIL was unset) also enables a
 * simple per-email rate-limit check on new submissions.
 */
model ContactSubmission {
  id               String                  @id @default(cuid())
  name             String
  company          String
  email            String
  phone            String?
  preferredContact ContactPreference       @default(EMAIL)
  intent           EnquiryIntent           @default(GENERAL)
  reason           String
  moduleId         String?
  expectedUsers    Int?
  country          String?
  industry         String?
  message          String?                 @db.Text
  status           ContactSubmissionStatus @default(NEW)
  organizationId   String?
  assignedToId     String?
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("ContactSubmissionsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  module        Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  moduleRequest ModuleRequest?
  subscription  Subscription?

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([moduleId])
}

model Subscription {
  id                  String                  @id @default(cuid())
  organizationId      String
  moduleId            String
  moduleRequestId     String?                 @unique
  contactSubmissionId String?                 @unique
  mode                SubscriptionMode
  status              SubscriptionStatus      @default(PENDING_PAYMENT)
  durationMonths      Int
  amount              Decimal                 @db.Decimal(18, 2)
  currency            String                  @default("GHS")
  startsAt            DateTime?
  endsAt              DateTime?
  autoRenew           Boolean                 @default(false)
  paymentReference    String?
  paymentMethod       String?
  gatewayProvider     PaymentGatewayProvider?
  paidAt              DateTime?
  notes               String?                 @db.Text
  createdById         String
  activatedById       String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module            Module             @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleRequest     ModuleRequest?     @relation(fields: [moduleRequestId], references: [id], onDelete: SetNull)
  contactSubmission ContactSubmission? @relation(fields: [contactSubmissionId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("SubscriptionsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy       User?              @relation("SubscriptionsActivated", fields: [activatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([moduleId, status])
  @@index([endsAt])
  @@index([gatewayProvider, paymentReference])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  channel        NotificationChannel @default(IN_APP)
  title          String
  message        String              @db.Text
  status         NotificationStatus  @default(QUEUED)
  metadata       Json?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, readAt])
}

model FileAsset {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  uploadedById   String?
