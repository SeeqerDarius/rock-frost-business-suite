  item      InventoryItem?          @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([orderLineId])
}

enum ProcurementSupplierInvoiceStatus {
  DRAFT
  MATCHED
  EXCEPTION
  APPROVED
  PARTIALLY_PAID
  PAID
  REJECTED
