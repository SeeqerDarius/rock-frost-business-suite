  movementsFrom              InventoryMovement[]   @relation("MovementWarehouse")
  movementsTo                InventoryMovement[]   @relation("MovementToWarehouse")
  procurementSettingsDefault ProcurementSettings[]
  posRegisters               PosRegister[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
}

