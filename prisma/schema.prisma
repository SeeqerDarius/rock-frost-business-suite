  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations HotelReservation[]

  @@unique([organizationId, guestNumber])
  @@index([organizationId, lastName])
  @@index([organizationId, phone])
}

model HotelReservation {
  id                 String                 @id @default(cuid())
  organizationId     String
  propertyId         String
  roomTypeId         String
  roomId             String?
  guestId            String
  confirmationCode   String
  status             HotelReservationStatus @default(PENDING)
  arrivalDate        DateTime
  departureDate      DateTime
  adults             Int                    @default(1)
  children           Int                    @default(0)
  nightlyRate        Decimal                @db.Decimal(12, 2)
  source             String?
  channelReference   String?
  specialRequests    String?                @db.Text
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room         HotelRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guest        HotelGuest    @relation(fields: [guestId], references: [id], onDelete: Restrict)
  folio        HotelFolio?

  @@unique([organizationId, confirmationCode])
  @@index([organizationId, status, arrivalDate])
  @@index([roomId, arrivalDate, departureDate])
  @@index([guestId])
}

model HotelFolio {
  id             String    @id @default(cuid())
  organizationId String
  reservationId  String    @unique
  folioNumber    String
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  HotelReservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  entries      HotelFolioEntry[]
  payments     HotelPayment[]
  orders       HotelOrder[]

  @@unique([organizationId, folioNumber])
  @@index([organizationId, closedAt])
}

model HotelFolioEntry {
  id              String              @id @default(cuid())
  organizationId  String
  folioId         String
  type            HotelFolioEntryType
  description     String
  amount          Decimal             @db.Decimal(12, 2)
  reference       String?
  reversedEntryId String?
  postedAt        DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folio        HotelFolio   @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@index([organizationId, postedAt])
  @@index([folioId])
  @@index([reversedEntryId])
}

model HotelPayment {
  id             String             @id @default(cuid())
  organizationId String
  folioId        String
  receiptNumber  String
  amount         Decimal            @db.Decimal(12, 2)
  method         HotelPaymentMethod
  reference      String?
  refundedAt     DateTime?
  receivedAt     DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folio        HotelFolio   @relation(fields: [folioId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, receivedAt])
  @@index([folioId])
}

model HotelHousekeepingTask {
  id             String                  @id @default(cuid())
  organizationId String
  roomId         String
  status         HotelHousekeepingStatus @default(PENDING)
  assignedTo     String?
  priority       String                  @default("NORMAL")
  notes          String?                 @db.Text
  dueAt          DateTime?
  completedAt    DateTime?
  inspectedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room         HotelRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([roomId])
}

model HotelRestaurantOutlet {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  menuItems    HotelMenuItem[]
  orders       HotelOrder[]

  @@unique([propertyId, name])
  @@index([organizationId, active])
}

model HotelMenuItem {
  id             String   @id @default(cuid())
  organizationId String
  outletId       String
  name           String
  category       String?
  price          Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       HotelRestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderLines   HotelOrderLine[]

  @@index([organizationId, active])
  @@index([outletId])
}

model HotelOrder {
  id             String           @id @default(cuid())
  organizationId String
  outletId       String
  folioId        String?
  orderNumber    String
  tableOrRoom    String?
  status         HotelOrderStatus @default(OPEN)
  total          Decimal          @default(0) @db.Decimal(12, 2)
  openedAt       DateTime         @default(now())
  completedAt    DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       HotelRestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  folio        HotelFolio?           @relation(fields: [folioId], references: [id], onDelete: SetNull)
  lines        HotelOrderLine[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([outletId])
}

model HotelOrderLine {
  id             String  @id @default(cuid())
  organizationId String
  orderId        String
  menuItemId     String?
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        HotelOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     HotelMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([orderId])
}

model HotelChannel {
  id                 String    @id @default(cuid())
  organizationId     String
  propertyId         String
  provider           String
  externalPropertyId String?
  active             Boolean   @default(false)
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, provider])
  @@index([organizationId, active])
}

model HotelSettings {
  id                            String   @id @default(cuid())
  organizationId                String
  propertyId                    String   @unique
  checkInTime                   String   @default("14:00")
  checkOutTime                  String   @default("11:00")
  taxRate                       Decimal  @default(0) @db.Decimal(5, 2)
  serviceChargeRate             Decimal  @default(0) @db.Decimal(5, 2)
  allowOutstandingCheckout      Boolean  @default(false)
  reservationPrefix             String   @default("RSV")
  folioPrefix                   String   @default("FOL")
  receiptPrefix                 String   @default("HRC")
  orderPrefix                   String   @default("ORD")
  autoCreateCheckoutTask        Boolean  @default(true)
  housekeepingDueHours          Int      @default(4)
  requireHousekeepingInspection Boolean  @default(false)
  /** Sends the guest an SMS (via mNotify, see src/lib/sms.ts) when a reservation is confirmed - see docs/SMS_INTEGRATION.md. */
  smsNotificationsEnabled       Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     HotelProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum SchoolStudentStatus {
  APPLICANT
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

enum SchoolEnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum SchoolAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolInvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  VOID
}

enum SchoolExamStatus {
  DRAFT
  OPEN
  MODERATION
  PUBLISHED
  CLOSED
}

enum SchoolLibraryLoanStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

model SchoolCampus {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
  name           String
  address        String?
  phone          String?
  email          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classes         SchoolClass[]
  students        SchoolStudent[]
  enrollments     SchoolEnrollment[]
  timetable       SchoolTimetableEntry[]
  routes          SchoolTransportRoute[]
  settings        SchoolSettings?
  feeStructures   SchoolFeeStructure[]
