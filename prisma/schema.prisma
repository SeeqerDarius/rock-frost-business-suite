  @@unique([skillTypeId, name])
  @@index([skillTypeId])
}

model HrEmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  skillId    String
  level      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    HrSkill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@index([employeeId])
  @@index([skillId])
}

/**
 * Simple organization-configured named lookups, shipped as real CRUD on the
 * Configuration page but deliberately without deeper logic yet (no calendar
 * engine for HrWorkingSchedule, no document generation for
 * HrContractTemplate, no link into other workflows) - an explicit scoping
 * decision, not a silent gap. HrJobPosition is the one exception with a real
 * consumer: it seeds a creatable combobox for HrEmployee.jobTitle, which
 * stays the free-text column of record (no FK, no migration risk).
 */
enum HrWorkLocationType {
  OFFICE
  REMOTE
  HYBRID
}

model HrEmployeeType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractTemplates HrContractTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HrWorkLocation {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  locationType   HrWorkLocationType @default(OFFICE)
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HrDepartureReason {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HrWorkingSchedule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractTemplates HrContractTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HrTimeType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HrJobPosition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractTemplates HrContractTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/**
 * The one lookup from the batch above that graduated into a real, editable
 * form (matching Odoo's own Contract Template: job, HR responsible,
 * department, and a Salary Information section) rather than shipping as a
 * bare name - still no document generation and no link into Payroll's own
 * PayrollCompensation, which stays the source of truth once an employee is
 * actually hired; a template is just what a future contract should start
 * from.
 */
model HrContractTemplate {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  jobPositionId       String?
  department          String?
  hrResponsibleId     String?
  employeeTypeId      String?
  wageType            String   @default("FIXED")
  payFrequency        String   @default("MONTHLY")
  wage                Decimal  @default(0) @db.Decimal(12, 2)
  excludedFromPayRuns Boolean  @default(false)
  workingScheduleId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPosition     HrJobPosition?     @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  hrResponsible   User?              @relation(fields: [hrResponsibleId], references: [id], onDelete: SetNull)
  employeeType    HrEmployeeType?    @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  workingSchedule HrWorkingSchedule? @relation(fields: [workingScheduleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([jobPositionId])
  @@index([hrResponsibleId])
  @@index([employeeTypeId])
  @@index([workingScheduleId])
}

model HrLeaveType {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  defaultDaysPerYear Int      @default(0)
  createdAt          DateTime @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests HrLeaveRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HrLeaveRequest {
  id             String        @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  status         HrLeaveStatus @default(PENDING)
  reason         String?       @db.Text
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    HrLeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model HrPerformanceReview {
  id                String         @id @default(cuid())
  organizationId    String
  employeeId        String
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime
  rating            Int?
  summary           String?        @db.Text
  status            HrReviewStatus @default(DRAFT)
