  DIRTY
  CLEANING
  INSPECTION
  OUT_OF_SERVICE
}

enum HotelReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum HotelFolioEntryType {
  CHARGE
  ADJUSTMENT
  REFUND
}

enum HotelPaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum HotelHousekeepingStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  INSPECTION
  COMPLETED
  BLOCKED
}

enum HotelOrderStatus {
  OPEN
  PREPARING
  SERVED
