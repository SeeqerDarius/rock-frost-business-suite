generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  PUSH
}

enum NotificationStatus {
  DRAFT
  QUEUED
  SENT
  READ
  FAILED
}

enum ModuleRequestType {
  DEMO
  ENABLE_EXISTING
  CUSTOMIZE_EXISTING
  CUSTOM_MODULE
  INTEGRATION
  DATA_MIGRATION
}

enum ModuleRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  QUOTED
  APPROVED
  REJECTED
  IMPLEMENTING
  READY
  COMPLETED
  CANCELLED
}

enum ModuleRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContactSubmissionStatus {
  NEW
  LINKED
  RESOLVED
  SPAM
}

enum ContactPreference {
  EMAIL
  PHONE
  WHATSAPP
}

enum EnquiryIntent {
  DEMO
  MODULE
  GENERAL
  SUPPORT
  CUSTOM_MODULE
}

enum SubscriptionMode {
  MANUAL_OFFLINE
  PLATFORM_MANAGED
}

enum PaymentGatewayProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum SubscriptionStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum FleetVehicleStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  INACTIVE
  RETIRED
}

enum FleetDocumentStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  MISSING
}

enum FleetDriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FleetMaintenanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FleetMaintenanceProgressStatus {
  REPORTED
  REVIEWING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FleetMaintenanceEventType {
  SUBMITTED
  MANAGER_REVIEWED
  OWNER_APPROVED
  OWNER_REJECTED
  MECHANIC_ASSIGNED
  REPAIR_STARTED
  REPAIR_COMPLETED
  COMPLETION_VERIFIED
  OWNER_NOTIFIED
  CANCELLED
}

enum FleetPaymentType {
  WEEKLY_SALES
  OWNER_PAYOUT
  DRIVER_PAYMENT
  MAINTENANCE
  WORK_AND_PAY
  OTHER
}

enum FleetPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

enum FleetContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum FleetDocumentRenewalStatus {
  READY
  DUE
  CLEAR
}

enum HirePurchaseAccountStatus {
  ACTIVE
  COMPLETED
  OVERDUE
  DORMANT
  PROBATION
  CLOSED
  ARCHIVED
  SUSPENDED
  CANCELLED
}

enum HirePurchaseDeliveryStatus {
  PENDING
  DELIVERED
}

enum HirePurchaseCreditStatus {
  OPEN
  REFUNDED
  APPLIED
  VOID
}

enum HirePurchaseCreditSource {
  PAYMENT_OVERPAYMENT
  ACCOUNT_CLOSURE_REFUND
  MANUAL_ADJUSTMENT
}

model User {
  id                  String     @id @default(cuid())
  name                String?
  firstName           String?
  lastName            String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  phone               String?
  status              UserStatus @default(INVITED)
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  accounts                        Account[]
  sessions                        Session[]
  organizationMemberships         OrganizationMember[]
  invitationsCreated              Invitation[]              @relation("InvitationsCreated")
  auditLogs                       AuditLog[]
  notifications                   Notification[]
  uploadedFiles                   FileAsset[]
  fleetDriverProfiles             FleetDriver[]
  fleetOwnerProfiles              FleetOwner[]
  maintenanceRequests             FleetMaintenanceRequest[]
  fleetMaintenanceEvents          FleetMaintenanceEvent[]
  hirePurchaseStaffProfiles       HirePurchaseStaff[]
  crmContactsOwned                CrmContact[]
  crmLeadsOwned                   CrmLead[]
  crmDealsOwned                   CrmDeal[]
  crmActivitiesCreated            CrmActivity[]
  inventoryMovementsCreated       InventoryMovement[]
  accountingInvoicesCreated       AccountingInvoice[]
  accountingExpensesCreated       AccountingExpense[]
  accountingJournalEntriesCreated AccountingJournalEntry[]
  hrEmployeeProfiles              HrEmployee[]
  hrLeaveRequestsApproved         HrLeaveRequest[]
  hrPerformanceReviewsConducted   HrPerformanceReview[]
  procurementRequestsRequested    ProcurementRequest[]      @relation("ProcurementRequestsRequested")
  procurementRequestsApproved     ProcurementRequest[]      @relation("ProcurementRequestsApproved")
  procurementOrdersCreated        ProcurementOrder[]
  payrollRunsCreated              PayrollRun[]
  posSessionsOpened               PosSession[]              @relation("PosSessionsOpened")
  posSessionsClosed               PosSession[]              @relation("PosSessionsClosed")
  posSalesRecorded                PosSale[]
  projectsOwned                   Project[]                 @relation("ProjectsOwned")
  projectMemberships              ProjectMember[]           @relation("ProjectMemberships")
  projectTasksAssigned            ProjectTask[]             @relation("ProjectTasksAssigned")
  projectTasksCreated             ProjectTask[]             @relation("ProjectTasksCreated")
  moduleRequestsCreated           ModuleRequest[]           @relation("ModuleRequestsCreated")
  moduleRequestsAssigned          ModuleRequest[]           @relation("ModuleRequestsAssigned")
  moduleRequestEvents             ModuleRequestEvent[]
  contactSubmissionsAssigned      ContactSubmission[]       @relation("ContactSubmissionsAssigned")
  subscriptionsCreated            Subscription[]            @relation("SubscriptionsCreated")
  subscriptionsActivated          Subscription[]            @relation("SubscriptionsActivated")
  organizationDeletionsRequested  Organization[]            @relation("OrganizationDeletionRequestedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

