generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  PUSH
}

enum NotificationStatus {
  DRAFT
  QUEUED
  SENT
  READ
  FAILED
}

enum FleetVehicleStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  INACTIVE
  RETIRED
}

enum FleetDocumentStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  MISSING
}

enum FleetDriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FleetMaintenanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FleetMaintenanceProgressStatus {
  REPORTED
  REVIEWING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FleetPaymentType {
  OWNER_PAYOUT
  DRIVER_PAYMENT
  MAINTENANCE
  WORK_AND_PAY
  OTHER
}

enum FleetPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

enum FleetContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum FleetDocumentRenewalStatus {
  READY
  DUE
  CLEAR
}

enum HirePurchaseAccountStatus {
  ACTIVE
  COMPLETED
  OVERDUE
  DORMANT
  PROBATION
  CLOSED
  ARCHIVED
  SUSPENDED
  CANCELLED
}

enum HirePurchaseDeliveryStatus {
  PENDING
  DELIVERED
}

enum HirePurchaseCreditStatus {
  OPEN
  REFUNDED
  APPLIED
  VOID
}

enum HirePurchaseCreditSource {
  PAYMENT_OVERPAYMENT
  ACCOUNT_CLOSURE_REFUND
  MANUAL_ADJUSTMENT
}

model User {
  id                  String     @id @default(cuid())
  name                String?
  firstName           String?
  lastName            String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  phone               String?
  status              UserStatus @default(INVITED)
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  organizationMemberships   OrganizationMember[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  uploadedFiles             FileAsset[]
  fleetDriverProfiles       FleetDriver[]
  maintenanceRequests       FleetMaintenanceRequest[]
  hirePurchaseStaffProfiles HirePurchaseStaff[]
  crmContactsOwned          CrmContact[]
  crmLeadsOwned             CrmLead[]
  crmDealsOwned             CrmDeal[]
  crmActivitiesCreated      CrmActivity[]
  inventoryMovementsCreated InventoryMovement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                         String             @id @default(cuid())
  name                       String
  industry                   String?
  tenantCode                 String             @unique
  address                    String?
  timezone                   String             @default("UTC")
  billingEmail               String?
  status                     OrganizationStatus @default(TRIAL)
  metadata                   Json?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  businessRegistrationNumber String?
  taxNumber                  String?
  country                    String?
  region                     String?
  city                       String?
  phone                      String?
  email                      String?
  website                    String?
  logoUrl                    String?
  currency                   String             @default("USD")
  defaultLanguage            String             @default("en")

  members                         OrganizationMember[]
  branches                        Branch[]
  roles                           Role[]
  organizationModules             OrganizationModule[]
  auditLogs                       AuditLog[]
  notifications                   Notification[]
  fileAssets                      FileAsset[]
  fleetOwners                     FleetOwner[]
  fleetDrivers                    FleetDriver[]
  fleetVehicles                   FleetVehicle[]
  fleetVehicleDocuments           FleetVehicleDocument[]
  maintenanceRequests             FleetMaintenanceRequest[]
  fleetPayments                   FleetPayment[]
  workAndPayContracts             FleetWorkAndPayContract[]
  hirePurchaseStaff               HirePurchaseStaff[]
  hirePurchaseStaffSalaryPayments HirePurchaseStaffSalaryPayment[]
  hirePurchaseStaffSalaryHistory  HirePurchaseStaffSalaryHistory[]
  hirePurchaseProductCategories   HirePurchaseProductCategory[]
  hirePurchaseProducts            HirePurchaseProduct[]
  hirePurchaseStaffInventory      HirePurchaseStaffInventory[]
  hirePurchaseCustomers           HirePurchaseCustomer[]
  hirePurchaseAccounts            HirePurchaseAccount[]
  hirePurchasePayments            HirePurchasePayment[]
  hirePurchaseCredits             HirePurchaseCredit[]
  hirePurchaseSettings            HirePurchaseSettings?
  crmLeadSources                  CrmLeadSource[]
  crmContacts                     CrmContact[]
  crmLeads                        CrmLead[]
  crmDeals                        CrmDeal[]
  crmActivities                   CrmActivity[]
  inventoryCategories             InventoryCategory[]
  inventoryWarehouses             InventoryWarehouse[]
  inventoryItems                  InventoryItem[]
  inventoryMovements              InventoryMovement[]

  @@index([industry])
  @@index([status])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String?
  branchId       String?
  status         MemberStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([branchId])
  @@index([roleId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  timezone       String?
  contactEmail   String?
  status         BranchStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members               OrganizationMember[]
  auditLogs             AuditLog[]
  fileAssets            FileAsset[]
  fleetOwners           FleetOwner[]
  fleetDrivers          FleetDriver[]
  fleetVehicles         FleetVehicle[]
  fleetVehicleDocuments FleetVehicleDocument[]
  maintenanceRequests   FleetMaintenanceRequest[]
  fleetPayments         FleetPayment[]
  workAndPayContracts   FleetWorkAndPayContract[]
  hirePurchaseStaff     HirePurchaseStaff[]
  hirePurchaseCustomers HirePurchaseCustomer[]
  hirePurchaseAccounts  HirePurchaseAccount[]
  crmContacts           CrmContact[]
  crmLeads              CrmLead[]
  crmDeals              CrmDeal[]
  crmActivities         CrmActivity[]
  inventoryWarehouses   InventoryWarehouse[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         OrganizationMember[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  moduleCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Module {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  status      ModuleStatus @default(ACTIVE)
  isCore      Boolean      @default(false)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationModules OrganizationModule[]
}

model OrganizationModule {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  enabled        Boolean   @default(false)
  configuration  Json?
  enabledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([moduleId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String?
  action         String
  entityName     String
  entityId       String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([branchId])
  @@index([userId])
  @@index([entityName, entityId])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  channel        NotificationChannel @default(IN_APP)
  title          String
  message        String              @db.Text
  status         NotificationStatus  @default(QUEUED)
  metadata       Json?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, readAt])
}

model FileAsset {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  uploadedById   String?
  fileName       String
  mimeType       String
  size           Int
  storagePath    String
  url            String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  uploadedBy        User?                     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  maintenancePhotos FleetMaintenanceRequest[]

  @@index([organizationId])
  @@index([branchId])
  @@index([uploadedById])
}

model FleetOwner {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  businessName   String?
  phone          String?
  email          String?
  history        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicles     FleetVehicle[]

  @@index([organizationId])
  @@index([branchId])
  @@index([email])
}

model FleetDriver {
  id                  String            @id @default(cuid())
  organizationId      String
  branchId            String?
  userId              String?
  name                String
  licenceNumber       String?
  licenceExpiry       DateTime?
  phone               String?
  email               String?
  status              FleetDriverStatus @default(ACTIVE)
  employmentStartDate DateTime?
  performanceMetrics  Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedVehicles FleetVehicle[]

  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
  @@index([licenceNumber])
}

model FleetVehicle {
  id               String              @id @default(cuid())
  organizationId   String
  branchId         String?
  assetTag         String
  plateNumber      String
  type             String?
  make             String?
  model            String?
  year             Int?
  ownerId          String?
  assignedDriverId String?
  status           FleetVehicleStatus  @default(AVAILABLE)
  documentStatus   FleetDocumentStatus @default(MISSING)
  mileage          Int?
  location         String?
  nextServiceDueAt DateTime?
  serviceNotes     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documents           FleetVehicleDocument[]
  owner               FleetOwner?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  assignedDriver      FleetDriver?              @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  maintenanceRequests FleetMaintenanceRequest[]
  workAndPayContracts FleetWorkAndPayContract[]

  @@unique([organizationId, assetTag])
  @@unique([organizationId, plateNumber])
  @@index([branchId])
  @@index([ownerId])
  @@index([assignedDriverId])
}

model FleetVehicleDocument {
  id                  String                     @id @default(cuid())
  organizationId      String
  branchId            String?
  vehicleId           String
  provider            String
  policyNumber        String
  insuranceExpiresAt  DateTime
  roadworthyExpiresAt DateTime
  renewalStatus       FleetDocumentRenewalStatus @default(CLEAR)
  alerts              String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle      FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([vehicleId])
}

model FleetMaintenanceRequest {
  id                  String                         @id @default(cuid())
  organizationId      String
  branchId            String?
  vehicleId           String
  requestedById       String?
  faultDescription    String                         @db.Text
  photoAssetId        String?
  approvalStatus      FleetMaintenanceApprovalStatus @default(PENDING)
  fleetManagerReview  String?                        @db.Text
  ownerApprovalStatus FleetMaintenanceApprovalStatus @default(PENDING)
  mechanicAssigned    String?
  progressStatus      FleetMaintenanceProgressStatus @default(REPORTED)
  repairCost          Decimal?                       @db.Decimal(12, 2)
  completionVerified  Boolean                        @default(false)
  requestedAt         DateTime                       @default(now())
  completedAt         DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle      FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  photoAsset   FileAsset?   @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)

  @@index([organizationId, progressStatus])
  @@index([branchId])
  @@index([vehicleId])
  @@index([requestedById])
  @@index([photoAssetId])
}

model FleetPayment {
  id              String             @id @default(cuid())
  organizationId  String
  branchId        String?
  reference       String
  date            DateTime           @default(now())
  type            FleetPaymentType
  amount          Decimal            @db.Decimal(12, 2)
  status          FleetPaymentStatus @default(PENDING)
  relatedEntity   String?
  relatedEntityId String?
  verified        Boolean            @default(false)
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, reference])
  @@index([organizationId, date])
  @@index([branchId])
  @@index([relatedEntity, relatedEntityId])
}

model FleetWorkAndPayContract {
  id                     String              @id @default(cuid())
  organizationId         String
  branchId               String?
  contractName           String
  vehicleId              String
  clientName             String
  contractAmount         Decimal             @db.Decimal(12, 2)
  depositAmount          Decimal             @default(0) @db.Decimal(12, 2)
  weeklyPaymentAmount    Decimal             @db.Decimal(12, 2)
  amountPaid             Decimal             @default(0) @db.Decimal(12, 2)
  outstandingBalance     Decimal             @default(0) @db.Decimal(12, 2)
  remainingDurationWeeks Int?
  completionPercentage   Decimal             @default(0) @db.Decimal(5, 2)
  contractStatus         FleetContractStatus @default(DRAFT)
  startsAt               DateTime?
  endsAt                 DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle      FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([organizationId, contractStatus])
  @@index([branchId])
  @@index([vehicleId])
}

model HirePurchaseStaff {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String?
  code           String
  fullName       String
  email          String?
  phone          String?
  active         Boolean  @default(true)
  monthlySalary  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch?                          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user              User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  customers         HirePurchaseCustomer[]
  salaryPayments    HirePurchaseStaffSalaryPayment[]
  salaryHistory     HirePurchaseStaffSalaryHistory[]
  inventory         HirePurchaseStaffInventory[]
  inventoryAccounts HirePurchaseAccount[]            @relation("HirePurchaseAccountInventoryStaff")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
}

model HirePurchaseStaffSalaryPayment {
  id             String   @id @default(cuid())
  organizationId String
  staffId        String
  amount         Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime
  salaryMonth    DateTime
  notes          String?
  paidBy         String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        HirePurchaseStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([staffId, salaryMonth])
}

model HirePurchaseStaffSalaryHistory {
  id             String   @id @default(cuid())
  organizationId String
  staffId        String
  monthlySalary  Decimal  @db.Decimal(12, 2)
  effectiveMonth DateTime
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        HirePurchaseStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, effectiveMonth])
  @@index([organizationId])
}

model HirePurchaseProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model HirePurchaseProduct {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String
  description    String?  @db.Text
  imageUrl       String?
  costPrice      Decimal  @db.Decimal(12, 2)
  transportCost  Decimal  @default(0) @db.Decimal(12, 2)
  dailyAmount    Decimal  @db.Decimal(12, 2)
  duration       Int
  price          Decimal  @db.Decimal(12, 2)
  quantityOnSale Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       HirePurchaseAccount[]
  staffInventory HirePurchaseStaffInventory[]

  @@index([organizationId])
  @@index([category])
}

model HirePurchaseStaffInventory {
  id             String   @id @default(cuid())
  organizationId String
  staffId        String
  productId      String
  quantity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        HirePurchaseStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  product      HirePurchaseProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([staffId, productId])
  @@index([organizationId])
  @@index([productId])
}

model HirePurchaseCustomer {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  customerCode   String
  fullName       String
  phone          String?
  address        String?
  nationalId     String?
  photoUrl       String?
  staffId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staff        HirePurchaseStaff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  accounts     HirePurchaseAccount[]
  credits      HirePurchaseCredit[]

  @@unique([organizationId, customerCode])
  @@index([organizationId])
  @@index([branchId])
  @@index([staffId])
  @@index([phone])
}

model HirePurchaseAccount {
  id               String                     @id @default(cuid())
  organizationId   String
  branchId         String?
  customerId       String
  productId        String
  inventoryStaffId String?
  startDate        DateTime
  expectedEndDate  DateTime
  targetAmount     Decimal                    @db.Decimal(12, 2)
  dailyAmount      Decimal                    @db.Decimal(12, 2)
  totalPaid        Decimal                    @default(0) @db.Decimal(12, 2)
  balance          Decimal                    @db.Decimal(12, 2)
  status           HirePurchaseAccountStatus  @default(ACTIVE)
  deliveryStatus   HirePurchaseDeliveryStatus @default(PENDING)
  deliveredAt      DateTime?
  deliveredBy      String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer       HirePurchaseCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        HirePurchaseProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryStaff HirePurchaseStaff?    @relation("HirePurchaseAccountInventoryStaff", fields: [inventoryStaffId], references: [id], onDelete: SetNull)
  payments       HirePurchasePayment[]
  credits        HirePurchaseCredit[]

  @@index([organizationId, status])
  @@index([branchId])
  @@index([customerId])
  @@index([productId])
  @@index([inventoryStaffId])
}

model HirePurchasePayment {
  id             String   @id @default(cuid())
  organizationId String
  receiptNo      String
  accountId      String
  amount         Decimal  @db.Decimal(12, 2)
  paymentDate    DateTime
  method         String
  notes          String?
  receivedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      HirePurchaseAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  credit       HirePurchaseCredit?

  @@unique([organizationId, receiptNo])
  @@index([organizationId])
  @@index([accountId])
}

model HirePurchaseCredit {
  id              String                   @id @default(cuid())
  organizationId  String
  customerId      String
  accountId       String?
  paymentId       String?                  @unique
  amount          Decimal                  @db.Decimal(12, 2)
  remainingAmount Decimal                  @db.Decimal(12, 2)
  status          HirePurchaseCreditStatus @default(OPEN)
  source          HirePurchaseCreditSource
  notes           String?
  createdBy       String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     HirePurchaseCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account      HirePurchaseAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payment      HirePurchasePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([customerId])
  @@index([accountId])
}

model HirePurchaseSettings {
  id                              String   @id @default(cuid())
  organizationId                  String   @unique
  installmentDurationDays         Int      @default(184)
  defaultDailyCollection          Decimal  @default(0) @db.Decimal(12, 2)
  administrationFeePercent        Decimal  @default(0) @db.Decimal(5, 2)
  refundDeductionPercent          Decimal  @default(32) @db.Decimal(5, 2)
  deliveryTimeAfterCompletionDays Int      @default(2)
  procurementThresholdPercent     Decimal  @default(70) @db.Decimal(5, 2)
  paymentEditWindowHours          Int      @default(3)
  minimumDeposit                  Decimal  @default(0) @db.Decimal(12, 2)
  defaultMonthlySalary            Decimal  @default(0) @db.Decimal(12, 2)
  defaultStaffInventoryQuantity   Int      @default(10)
  commissionEnabled               Boolean  @default(false)
  commissionPercentage            Decimal  @default(0) @db.Decimal(5, 2)
  payrollDay                      Int      @default(1)
  receiptPrefix                   String   @default("RCPT")
  customerIdPrefix                String   @default("CUST")
  staffCodeLength                 Int      @default(3)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum CrmDealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

model CrmLeadSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  fullName       String
  company        String?
  email          String?
  phone          String?
  jobTitle       String?
  notes          String?  @db.Text
  ownerId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leads        CrmLead[]
  deals        CrmDeal[]
  activities   CrmActivity[]

  @@index([organizationId])
  @@index([branchId])
  @@index([ownerId])
  @@index([email])
}

model CrmLead {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String?
  contactId      String?
  fullName       String
  company        String?
  email          String?
  phone          String?
  source         String?
  status         CrmLeadStatus @default(NEW)
  ownerId        String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contact       CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities    CrmActivity[]
  convertedDeal CrmDeal?

  @@index([organizationId, status])
  @@index([branchId])
  @@index([contactId])
  @@index([ownerId])
}

model CrmDeal {
  id                String       @id @default(cuid())
  organizationId    String
  branchId          String?
  contactId         String?
  leadId            String?      @unique
  title             String
  value             Decimal      @default(0) @db.Decimal(12, 2)
  stage             CrmDealStage @default(NEW)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  ownerId           String?
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contact      CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         CrmLead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]

  @@index([organizationId, stage])
  @@index([branchId])
  @@index([contactId])
  @@index([ownerId])
}

model CrmActivity {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String?
  type           CrmActivityType
  subject        String
  notes          String?         @db.Text
  occurredAt     DateTime        @default(now())
  contactId      String?
  leadId         String?
  dealId         String?
  createdById    String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contact      CrmContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead         CrmLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         CrmDeal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([branchId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER
}

model InventoryCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model InventoryWarehouse {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  location       String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stock         InventoryStock[]
  movementsFrom InventoryMovement[] @relation("MovementWarehouse")
  movementsTo   InventoryMovement[] @relation("MovementToWarehouse")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  categoryId     String?
  unit           String   @default("unit")
  costPrice      Decimal  @default(0) @db.Decimal(12, 2)
  reorderPoint   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     InventoryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock        InventoryStock[]
  movements    InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
}

model InventoryStock {
  id          String   @id @default(cuid())
  itemId      String
  warehouseId String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  item      InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  itemId         String
  type           InventoryMovementType
  quantity       Int
  warehouseId    String
  toWarehouseId  String?
  reference      String?
  notes          String?               @db.Text
  createdById    String?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse    InventoryWarehouse  @relation("MovementWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  toWarehouse  InventoryWarehouse? @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([itemId])
  @@index([warehouseId])
  @@index([toWarehouseId])
}
