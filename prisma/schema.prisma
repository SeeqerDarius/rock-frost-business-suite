  contactSubmissionId        String?                 @unique
  mode                       SubscriptionMode
  status                     SubscriptionStatus      @default(PENDING_PAYMENT)
  durationMonths             Int
  amount                     Decimal                 @db.Decimal(18, 2)
  currency                   String                  @default("GHS")
  startsAt                   DateTime?
  endsAt                     DateTime?
  autoRenew                  Boolean                 @default(false)
  seatLimit                  Int?
  paymentReference           String?
  paymentMethod              String?
  gatewayProvider            PaymentGatewayProvider?
  paidAt                     DateTime?
  paystackPlanCode           String?                 @unique
  paystackSubscriptionCode   String?                 @unique
  paystackCustomerCode       String?
  paystackEmailToken         String?
  paystackNextPaymentAt      DateTime?
  paystackSubscriptionStatus String?
  lastRenewalAt              DateTime?
  lastPaymentFailureAt       DateTime?
  renewalFailureCount        Int                     @default(0)
  notes                      String?                 @db.Text
  bundleKey                  String?
  entitledModuleKeys         String[]                @default([])
  createdById                String
  activatedById              String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
