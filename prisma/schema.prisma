  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([branchId])
}

model SchoolAcademicYear {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  current        Boolean   @default(false)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms               SchoolTerm[]
  enrollments         SchoolEnrollment[]
  feeInvoices         SchoolFeeInvoice[]
  feeStructures       SchoolFeeStructure[]
  exams               SchoolExam[]
  hostelAllocations   HostelAllocation[]
  hostelFeeInvoices   HostelFeeInvoice[]
  hostelFeeStructures HostelFeeStructure[]

  @@unique([organizationId, name])
  @@index([organizationId, current])
}

model SchoolTerm {
  id             String    @id @default(cuid())
  organizationId String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  current        Boolean   @default(false)
  closedAt       DateTime?

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear        SchoolAcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendance          SchoolAttendance[]
  feeInvoices         SchoolFeeInvoice[]
  feeStructures       SchoolFeeStructure[]
  exams               SchoolExam[]
  timetable           SchoolTimetableEntry[]
  hostelFeeInvoices   HostelFeeInvoice[]
  hostelFeeStructures HostelFeeStructure[]

  @@unique([academicYearId, name])
  @@index([organizationId, current])
}

model SchoolGuardian {
  id             String   @id @default(cuid())
  organizationId String
  guardianNumber String
  firstName      String
  lastName       String
  email          String?
  phone          String
  address        String?
  occupation     String?
  photoData      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students     SchoolStudentGuardian[]

  @@unique([organizationId, guardianNumber])
  @@index([organizationId, phone])
}

model SchoolStudent {
  id              String              @id @default(cuid())
  organizationId  String
  campusId        String
  admissionNumber String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String?
  status          SchoolStudentStatus @default(APPLICANT)
  admissionDate   DateTime?
  medicalNotes    String?             @db.Text
  photoData       String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus            SchoolCampus                  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  guardians         SchoolStudentGuardian[]
  enrollments       SchoolEnrollment[]
  attendance        SchoolAttendance[]
  feeInvoices       SchoolFeeInvoice[]
  feePayments       SchoolFeePayment[]
  examResults       SchoolExamResult[]
  transport         SchoolTransportAssignment[]
  libraryLoans      SchoolLibraryLoan[]
  lifecycleEvents   SchoolStudentLifecycleEvent[]
  hostelAllocations HostelAllocation[]
  hostelFeeInvoices HostelFeeInvoice[]
  hostelFeePayments HostelFeePayment[]

  @@unique([organizationId, admissionNumber])
  @@index([organizationId, status])
  @@index([campusId])
}

model SchoolStudentGuardian {
  id               String  @id @default(cuid())
  organizationId   String
  studentId        String
  guardianId       String
  relationship     String
  primary          Boolean @default(false)
  authorizedPickup Boolean @default(false)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      SchoolStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     SchoolGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([organizationId])
  @@index([guardianId])
}

model SchoolClass {
  id             String  @id @default(cuid())
  organizationId String
  campusId       String
  code           String
  name           String
  gradeLevel     String?
  capacity       Int?
  active         Boolean @default(true)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus        SchoolCampus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  enrollments   SchoolEnrollment[]
  attendance    SchoolAttendance[]
  results       SchoolExamResult[]
  timetable     SchoolTimetableEntry[]
  feeStructures SchoolFeeStructure[]
  teachers      SchoolClassTeacher[]

  @@unique([campusId, code])
  @@index([organizationId, active])
}

/**
 * Restricts a teacher-role user to only the class(es) they're assigned to
 * here when they record attendance or exam results (see
 * resolveTeacherClassScope in src/modules/school/service.ts). A user with
 * no rows in this table is unrestricted - assignment is opt-in per class,
 * not implied by holding the seeded "Teacher" role, so an admin can scope
 * any member this way without a hardcoded role-name check.
 */
model SchoolClassTeacher {
  id             String   @id @default(cuid())
  organizationId String
  classId        String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class        SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([organizationId, userId])
}

model SchoolSubject {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String? @db.Text
  active         Boolean @default(true)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exams        SchoolExam[]
  results      SchoolExamResult[]
  timetable    SchoolTimetableEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model SchoolEnrollment {
  id             String                 @id @default(cuid())
  organizationId String
  campusId       String
  academicYearId String
  studentId      String
  classId        String
  status         SchoolEnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime               @default(now())
  endedAt        DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicYear SchoolAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  student      SchoolStudent      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class        SchoolClass        @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([organizationId, status])
  @@index([classId])
}

model SchoolAttendance {
  id             String                 @id @default(cuid())
  organizationId String
  termId         String
  classId        String
  studentId      String
  date           DateTime
  status         SchoolAttendanceStatus
  reason         String?
  publishedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  term         SchoolTerm    @relation(fields: [termId], references: [id], onDelete: Restrict)
  class        SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  student      SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([studentId, date])
  @@index([organizationId, date])
  @@index([classId, date])
}

model SchoolFeeInvoice {
  id             String              @id @default(cuid())
  organizationId String
  academicYearId String
  termId         String?
  studentId      String
  feeStructureId String?
  invoiceNumber  String
  description    String
  amount         Decimal             @db.Decimal(12, 2)
  discount       Decimal             @default(0) @db.Decimal(12, 2)
  status         SchoolInvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear SchoolAcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         SchoolTerm?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  student      SchoolStudent       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeStructure SchoolFeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  payments     SchoolFeePayment[]

  @@unique([organizationId, invoiceNumber])
  @@unique([feeStructureId, studentId])
  @@index([organizationId, status])
  @@index([studentId])
}

model SchoolFeeStructure {
  id             String    @id @default(cuid())
  organizationId String
  campusId       String
  academicYearId String
  termId         String?
  classId        String?
  name           String
  description    String?   @db.Text
  amount         Decimal   @db.Decimal(12, 2)
  dueDate        DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       SchoolCampus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicYear SchoolAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         SchoolTerm?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  class        SchoolClass?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  invoices     SchoolFeeInvoice[]

  @@unique([organizationId, academicYearId, termId, classId, name])
  @@index([organizationId, active])
  @@index([campusId, academicYearId])
}

model SchoolStudentLifecycleEvent {
  id             String              @id @default(cuid())
  organizationId String
  studentId      String
  fromStatus     SchoolStudentStatus
  toStatus       SchoolStudentStatus
