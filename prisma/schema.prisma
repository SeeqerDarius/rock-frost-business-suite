  createdBy         User                  @relation("SubscriptionsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy       User?                 @relation("SubscriptionsActivated", fields: [activatedById], references: [id], onDelete: SetNull)
  payments          SubscriptionPayment[]

