enum AccountingPettyCashFundStatus {
  ACTIVE
  CLOSED
}

enum AccountingPettyCashTransactionType {
  FUNDING
  EXPENSE
  REPLENISHMENT
}

/**
 * Imprest-system petty cash: a dedicated AccountingAccount (liquidityType
 * CASH) backs the fund, so its balance is always derived from the same
 * journal-line ledger as every other account rather than tracked
 * separately. floatAmount is the fund's target level; replenishment tops
 * the account balance back up to it.
 */
model AccountingPettyCashFund {
  id             String                        @id @default(cuid())
  organizationId String
  accountId      String                        @unique
  name           String
  custodianName  String
  floatAmount    Decimal                       @db.Decimal(12, 2)
  status         AccountingPettyCashFundStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime                      @default(now())
  closedAt       DateTime?

  organization Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      AccountingAccount                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy    User?                            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactions AccountingPettyCashTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model AccountingPettyCashTransaction {
  id                String                             @id @default(cuid())
  organizationId    String
  fundId            String
  type              AccountingPettyCashTransactionType
  amount            Decimal                            @db.Decimal(12, 2)
  description       String
  expenseCategoryId String?
  journalEntryId    String?
  createdById       String?
  createdAt         DateTime                           @default(now())

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund            AccountingPettyCashFund    @relation(fields: [fundId], references: [id], onDelete: Cascade)
  expenseCategory AccountingExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  journalEntry    AccountingJournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, fundId])
  @@index([fundId, createdAt])
}

