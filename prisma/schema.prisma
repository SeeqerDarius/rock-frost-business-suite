enum PharmacyMedicineClass {
  OTC
  PHARMACY_ONLY
  PRESCRIPTION_ONLY
  CONTROLLED
}

enum PharmacyBatchStatus {
  AVAILABLE
  QUARANTINED
  RECALLED
  DEPLETED
}

enum PharmacyPrescriptionStatus {
  DRAFT
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
  EXPIRED
}

enum PharmacyDispensingStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  REVERSED
}

enum PharmacyStockMovementType {
  COUNT_ADJUSTMENT
  ADJUSTMENT
  WRITE_OFF
  SUPPLIER_RETURN
  PATIENT_RETURN
}

model PharmacyMedicine {
  id                   String                @id @default(cuid())
  organizationId       String
  sku                  String
  name                 String
  genericName          String?
  strength             String?
  dosageForm           String?
  unit                 String                @default("unit")
  medicineClass        PharmacyMedicineClass @default(OTC)
  registrationNumber   String?
  barcode              String?
  sellingPrice         Decimal               @default(0) @db.Decimal(12, 2)
  reorderPoint         Int                   @default(0)
  requiresPrescription Boolean               @default(false)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches           PharmacyBatch[]
  prescriptionLines PharmacyPrescriptionLine[]
  dispensingLines   PharmacyDispensingLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
}

model PharmacySupplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  licenceNumber  String?
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      PharmacyBatch[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model PharmacyBatch {
  id               String              @id @default(cuid())
  organizationId   String
  medicineId       String
  supplierId       String?
  batchNumber      String
  barcode          String?
  quantity         Int
  initialQuantity  Int
  costPrice        Decimal             @default(0) @db.Decimal(12, 2)
  manufactureDate  DateTime?
  expiryDate       DateTime
  receivedAt       DateTime            @default(now())
  status           PharmacyBatchStatus @default(AVAILABLE)
  invoiceReference String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  medicine        PharmacyMedicine         @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  supplier        PharmacySupplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  dispensingLines PharmacyDispensingLine[]
  stockMovements  PharmacyStockMovement[]

  @@unique([organizationId, medicineId, batchNumber])
  @@unique([organizationId, barcode])
  @@index([organizationId, status, expiryDate])
  @@index([medicineId, expiryDate])
}

model PharmacyPatient {
  id             String    @id @default(cuid())
  organizationId String
  patientNumber  String
  fullName       String
  dateOfBirth    DateTime?
  sex            String?
  phone          String?
  email          String?
  address        String?
  allergies      String?
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prescriptions PharmacyPrescription[]
  dispensings   PharmacyDispensing[]

  @@unique([organizationId, patientNumber])
  @@index([organizationId, fullName])
}

model PharmacyPrescriber {
  id                 String   @id @default(cuid())
  organizationId     String
  fullName           String
  registrationNumber String
  facilityName       String?
  phone              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prescriptions PharmacyPrescription[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId, active])
}

model PharmacyPrescription {
  id                 String                     @id @default(cuid())
  organizationId     String
  prescriptionNumber String
  patientId          String
  prescriberId       String
  prescribedAt       DateTime
  expiresAt          DateTime?
  status             PharmacyPrescriptionStatus @default(ACTIVE)
  clinicalNotes      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      PharmacyPatient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriber   PharmacyPrescriber         @relation(fields: [prescriberId], references: [id], onDelete: Restrict)
  lines        PharmacyPrescriptionLine[]
  dispensings  PharmacyDispensing[]

  @@unique([organizationId, prescriptionNumber])
  @@index([organizationId, status, prescribedAt])
  @@index([patientId])
}

model PharmacyPrescriptionLine {
  id                 String  @id @default(cuid())
  organizationId     String
  prescriptionId     String
  medicineId         String
  quantityPrescribed Int
  quantityDispensed  Int     @default(0)
  dosage             String
  frequency          String
  duration           String?
  instructions       String?

  prescription PharmacyPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     PharmacyMedicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([prescriptionId])
}

model PharmacyDispensing {
  id                  String                   @id @default(cuid())
  organizationId      String
  dispensingNumber    String
  patientId           String?
  prescriptionId      String?
  status              PharmacyDispensingStatus @default(COMPLETED)
  subtotal            Decimal                  @db.Decimal(12, 2)
  discount            Decimal                  @default(0) @db.Decimal(12, 2)
  total               Decimal                  @db.Decimal(12, 2)
  paymentMethod       String?
  paymentReference    String?
  dispensedById       String
  dispensedAt         DateTime                 @default(now())
  reversedAt          DateTime?
  reversalReason      String?
  /**
   * Controlled-drug maker-checker: snapshotted at request time from
   * PharmacySettings.controlledDispenseMakerCheckerEnabled, the same
   * pattern as HrTerminationRequest.makerCheckerEnabled. When true and the
   * request contains a CONTROLLED medicine, status starts PENDING_APPROVAL
   * and pendingLines holds the requested {medicineId, quantity,
   * prescriptionLineId} entries — batch allocation and the real
   * PharmacyDispensingLine/PharmacyRestrictedRegister rows are only created
   * once approveControlledDispense() runs, so no stock moves until a
   * different person confirms it.
   */
  makerCheckerEnabled Boolean                  @default(false)
  pendingLines        Json?
  approvedById        String?
  approvedAt          DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                 @default(now())

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient           PharmacyPatient?             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescription      PharmacyPrescription?        @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  lines             PharmacyDispensingLine[]
  restrictedEntries PharmacyRestrictedRegister[]

  @@unique([organizationId, dispensingNumber])
  @@index([organizationId, status, dispensedAt])
}

model PharmacyDispensingLine {
  id                 String  @id @default(cuid())
  organizationId     String
  dispensingId       String
  medicineId         String
  batchId            String
  prescriptionLineId String?
  quantity           Int
  unitPrice          Decimal @db.Decimal(12, 2)
  lineTotal          Decimal @db.Decimal(12, 2)

  dispensing PharmacyDispensing @relation(fields: [dispensingId], references: [id], onDelete: Restrict)
  medicine   PharmacyMedicine   @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch      PharmacyBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([dispensingId])
  @@index([batchId])
}

model PharmacyRestrictedRegister {
  id                     String   @id @default(cuid())
  organizationId         String
  dispensingId           String
  medicineName           String
  batchNumber            String
  quantity               Int
  patientName            String
  patientAddress         String?
  prescriberName         String?
  prescriberRegistration String?
  recordedById           String
  recordedAt             DateTime @default(now())
  reversalOfId           String?
  reason                 String?

  dispensing PharmacyDispensing @relation(fields: [dispensingId], references: [id], onDelete: Restrict)

  @@index([organizationId, recordedAt])
  @@index([dispensingId])
}

model PharmacySettings {
  id                                    String   @id @default(cuid())
  organizationId                        String   @unique
  licenceNumber                         String?
  superintendentPharmacist              String?
  superintendentRegistration            String?
  receiptPrefix                         String   @default("PHA")
  prescriptionValidityDays              Int      @default(30)
  expiryAlertDays                       Int      @default(90)
  allowNegativeStock                    Boolean  @default(false)
  requirePatientForControlled           Boolean  @default(true)
  /**
   * Snapshotted onto each PharmacyDispensing at request time — see PharmacyDispensing.makerCheckerEnabled.
   */
  controlledDispenseMakerCheckerEnabled Boolean  @default(true)
  /** Sends the patient an SMS (via mNotify, see src/lib/sms.ts) when a dispense completes - see docs/SMS_INTEGRATION.md. */
  smsNotificationsEnabled               Boolean  @default(false)
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * Append-only stock-movement ledger for the reconciliation workflows that
 * sit alongside receiveBatch/dispense/reverseDispensing: physical counts,
 * manual adjustments, write-offs, supplier returns, and patient returns.
 * Every row is immutable once created — a correction is a new row, never
 * an update, mirroring PharmacyRestrictedRegister's reversal-by-new-row
 * pattern. PATIENT_RETURN rows are record-only (quantityDelta is always 0)
 * — a returned medication is never silently restocked as dispensable; a
 * pharmacist who inspects and approves it uses a separate ADJUSTMENT entry
 * that references this row's id in its reason text.
 */
model PharmacyStockMovement {
  id             String                    @id @default(cuid())
  organizationId String
  batchId        String
  type           PharmacyStockMovementType
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int
  reason         String                    @db.Text
  reference      String?
  recordedById   String
  recordedAt     DateTime                  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        PharmacyBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([organizationId, recordedAt])
  @@index([batchId])
}

