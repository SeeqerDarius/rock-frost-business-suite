enum SmsMessageStatus {
  SENT
  FAILED
}

/** Every SMS this app sends, across every purpose (2FA, per-module notifications, support alerts, marketing) - the audit/delivery record and the dedup source (see relatedType/relatedId) for schedule-based senders like the Hospital appointment-reminder cron. */
model SmsMessage {
  id               String           @id @default(cuid())
  organizationId   String
  to               String
  body             String           @db.Text
  purpose          String
  relatedType      String?
  relatedId        String?
  status           SmsMessageStatus
  providerResponse Json?
  error            String?
  createdAt        DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, purpose, createdAt])
  @@index([relatedType, relatedId])
}

enum TwoFactorOtpPurpose {
  LOGIN
  ENROLL_VERIFY_PHONE
  DISABLE
}

/** A short-lived, hashed one-time code for SMS-based 2FA - login verification, phone-number enrollment, and disable confirmation each get their own purpose so a code issued for one can't be replayed against another. Login-purpose wrong codes count toward the account's existing failedLoginAttempts/lockedUntil lockout; enrollment/disable attempts are bounded by the `attempts` counter on this row instead. */
model TwoFactorOtpChallenge {
  id         String              @id @default(cuid())
  userId     String
  purpose    TwoFactorOtpPurpose
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, createdAt])
}

