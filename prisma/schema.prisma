  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  moduleCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
