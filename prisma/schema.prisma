  procurementThresholdPercent     Decimal  @default(70) @db.Decimal(5, 2)
  paymentEditWindowHours          Int      @default(3)
  minimumDeposit                  Decimal  @default(0) @db.Decimal(12, 2)
  defaultMonthlySalary            Decimal  @default(0) @db.Decimal(12, 2)
  defaultStaffInventoryQuantity   Int      @default(10)
