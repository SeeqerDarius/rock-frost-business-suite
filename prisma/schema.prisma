  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Module {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  status      ModuleStatus @default(ACTIVE)
  isCore      Boolean      @default(false)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationModules OrganizationModule[]
  moduleRequests      ModuleRequest[]
  contactSubmissions  ContactSubmission[]
  subscriptions       Subscription[]
}

/// Operator-editable catalogue prices, keyed by the customer-facing product
/// key (matches BusinessModuleKey in platform/modules/registry.ts), not a
/// relation to Module.id — the catalogue is a pricing concept distinct from
/// the internal Module rows a Subscription actually links to.
model ModulePricingPlan {
  id                String   @id @default(cuid())
  moduleKey         String   @unique
  monthlyGhs        Decimal  @db.Decimal(18, 2)
  annualGhs         Decimal  @db.Decimal(18, 2)
  includedSeats     Int
  additionalSeatGhs Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Operator-editable combined-suite prices. moduleKeys stores un-expanded
/// product keys (e.g. "hr", not "hr"+"payroll") — the same convention as
/// Subscription.entitledModuleKeys; display names are derived from the
/// module registry at read time rather than stored redundantly here.
model PricingBundle {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  monthlyGhs Decimal  @db.Decimal(18, 2)
  moduleKeys String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OrganizationModule {
  id             String    @id @default(cuid())
  organizationId String
  moduleId       String
  enabled        Boolean   @default(false)
  configuration  Json?
  enabledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([moduleId])
}

model ModuleRequest {
  id                    String                @id @default(cuid())
  organizationId        String
  moduleId              String?
  requestedById         String
  assignedToId          String?
  contactSubmissionId   String?               @unique
  type                  ModuleRequestType
  status                ModuleRequestStatus   @default(SUBMITTED)
  priority              ModuleRequestPriority @default(NORMAL)
  title                 String
  businessJustification String                @db.Text
  customizationDetails  String?               @db.Text
  expectedUsers         Int?
  externalReference     String?
  decisionReason        String?               @db.Text
  approvedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module            Module?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
