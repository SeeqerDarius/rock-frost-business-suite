# Rock Frost Desktop client environment template.
#
# Only the PUBLIC API origin belongs here. This client never holds, and
# must never be given, a Neon/PostgreSQL connection string or any other
# server-side secret. Copy this file to .env (gitignored) and fill in a
# real value before running `npm run dev` or `npm run tauri:dev`.

# The public origin the desktop client calls for the five sync endpoints
# in src/contract/sync-contract.ts. No trailing slash. This must exactly
# match an origin allowed by connect-src in src-tauri/tauri.conf.json's
# security.csp, or WebView2 rejects every request with "Failed to fetch"
# even though the fetch code itself is correct.
VITE_API_BASE_URL=https://app.rockfrostgroup.com

# Optional: surfaced in ActivateDeviceRequest.appVersion for the server's
# own device/version reporting. Defaults to package.json's version if unset.
VITE_APP_VERSION=0.2.5
