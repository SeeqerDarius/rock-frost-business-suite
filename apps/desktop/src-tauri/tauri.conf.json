{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rock Frost Business Suite",
  "version": "0.2.6",
  "identifier": "com.rockfrostgroup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rock Frost Business Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: https://ipc.localhost https://app.rockfrostgroup.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMjZGM0YyNDhEMTI2RjcKUldUM0p0Rkk4dk1tN0kzV1BPaUNlY3pwclpLckhsL3Vra1FBUkFydjBTbHdMbDFETXhjQkdodDAK",
      "endpoints": [
        "https://app.rockfrostgroup.com/api/desktop/releases/latest"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
