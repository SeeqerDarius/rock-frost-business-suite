node_modules/
dist/
dist-ssr/
*.local

# Tauri / Rust build artifacts. Cargo.lock is intentionally NOT ignored —
# this is an application, not a library, so it should be committed once a
# real Rust toolchain has generated it for reproducible builds.
src-tauri/target/
src-tauri/gen/

# Never commit real environment values, only .env.example
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
