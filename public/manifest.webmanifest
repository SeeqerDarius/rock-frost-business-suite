{
  "name": "Rock Frost Technologies",
  "short_name": "Rock Frost",
  "description": "Modular business management software for organizations in Ghana and Africa.",
  "id": "/app",
  "start_url": "/app/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020306",
  "theme_color": "#08b2ec",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    { "name": "Dashboard", "short_name": "Dashboard", "url": "/app/dashboard", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Point of Sale", "short_name": "POS", "url": "/app/pos/sell", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
