# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — this file exists so a fresh clone can see
# every variable the app expects without guessing.

# --- Database (Neon Postgres) ---
# DATABASE_URL is the pooled connection string (used by the app at runtime).
# DIRECT_URL is the unpooled connection string (used by Prisma Migrate, which
# needs a direct connection — pooled connections don't support the advisory
# locks migrations take).
DATABASE_URL=
DIRECT_URL=

# --- Integration tests (real disposable Postgres, never production) ---
# TEST_DATABASE_URL: a SEPARATE database from DATABASE_URL, dedicated to
# `npm run test:integration` — a Neon branch or local/Docker Postgres works.
# Its database name must contain "test"; test/integration/setup/guard.ts
# refuses to run otherwise, and also refuses if it matches DATABASE_URL/
# DIRECT_URL. See docs/TESTING_STRATEGY.md.
TEST_DATABASE_URL=

# --- NextAuth ---
# NEXTAUTH_URL: the canonical origin this app is served from and the base used
# for absolute links in password-reset and invitation emails (e.g.
# http://localhost:3000 in development, https://www.rockfrostgroup.com in
# production).
# NEXTAUTH_SECRET: a random secret used to sign session JWTs — generate one
# with `openssl rand -base64 32`, never reuse across environments.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Shared bearer token Vercel attaches to scheduled cron requests. Generate a
# long random value and set it in every production environment that runs crons.
CRON_SECRET=

# Separate host-only authentication surfaces. Do not set a parent-domain
# cookie: admin.* and app.* intentionally keep independent sessions.
PLATFORM_APP_URL=https://admin.rockfrostgroup.com
TENANT_APP_URL=https://app.rockfrostgroup.com

# --- Legacy public site URL (optional) ---
# Server-side email links fall back to this only when NEXTAUTH_URL is absent.
# New environments should use NEXTAUTH_URL as the single canonical origin.
NEXT_PUBLIC_SITE_URL=

# --- Resend (transactional email) ---
# If RESEND_API_KEY or RESEND_FROM_EMAIL is unset, the app degrades
# gracefully: emails are logged via console.warn instead of sent, and
# affected flows (invitations, password reset, contact form) still persist
# their data — nothing is silently lost, per docs/HARDENING_PLAN.md's
# Pass 3b fix for the contact form specifically.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where public contact-form submissions are forwarded (Rock Frost staff inbox).
RESEND_TO_EMAIL=

# --- Anthropic (AI assistant feature) ---
# Only needed if the ai.assistant.use permission / AI surface is exercised.
ANTHROPIC_API_KEY=

# --- Paystack (platform-managed subscription payment gateway) ---
# https://dashboard.paystack.com/#/settings/developers — use the *secret* key
# server-side only, never expose it to the browser. If unset, the tenant
# billing page (/app/organization/billing) simply hides the "Pay with
# Paystack" button rather than failing (see src/lib/payments/config.ts).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Flutterwave (platform-managed subscription payment gateway) ---
# https://dashboard.flutterwave.com/settings/apis — FLUTTERWAVE_WEBHOOK_HASH
# is a secret string you invent and set in BOTH the dashboard's webhook
# config and here; Flutterwave echoes it back in the `verif-hash` header on
# every webhook call instead of signing the payload. Same graceful
# degradation as Paystack above if unset.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
